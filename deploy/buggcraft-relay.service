[Unit]
Description=Buggcraft Minecraft room relay (Python AsyncSSH)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=buggcraft-node
Group=buggcraft-node
WorkingDirectory=/opt/buggcraft-node
ExecStart=/opt/buggcraft-node/.venv/bin/python src/main.py --config config/node/server.conf
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
LimitNOFILE=8192
MemoryMax=512M
TasksMax=512
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/buggcraft-node/config/node
UMask=0077

[Install]
WantedBy=multi-user.target
